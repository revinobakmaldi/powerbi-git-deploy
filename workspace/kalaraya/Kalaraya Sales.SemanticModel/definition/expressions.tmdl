/// Base URL of the folder that holds the Parquet files, ending with a slash. Points at the data folder of this repo on GitHub. Each table appends its file name, so every data source is a file URL (Power BI tests access on that URL).
expression DataUrl = "https://raw.githubusercontent.com/revinobakmaldi/powerbi-git-deploy/main/data/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 9b1c6e2a-1f0d-4c55-8a2e-6c7d3b9e0a11
